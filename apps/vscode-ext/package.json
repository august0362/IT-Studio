{
  "name": "itstudio-vscode",
  "version": "0.1.0",
  "publisher": "itstudio",
  "displayName": "IT Studio Companion",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.itstudio/session.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "itstudio.reconnect",
        "title": "IT Studio: Reconnect"
      },
      {
        "command": "itstudio.showLog",
        "title": "IT Studio: Show Log"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node build.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license -o dist/itstudio-vscode.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "~3.1.0",
    "@vscode/vsce": "~4.0.0",
    "esbuild": "^0.28.2"
  }
}
