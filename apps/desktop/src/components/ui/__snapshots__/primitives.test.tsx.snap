// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shared glow primitives > snapshots semantic dark primitives for neon-cyan 1`] = `
{
  "markup": <div
    aria-label="Project overview"
    class="studio-card "
  >
    <button
      class="studio-button studio-button-primary "
      type="button"
    >
      Run
    </button>
    <button
      class="studio-button studio-button-secondary "
      type="button"
    >
      Cancel
    </button>
    <button
      class="studio-button studio-button-danger "
      type="button"
    >
      Delete
    </button>
    <input
      aria-label="Project name"
      class="studio-input "
      placeholder="Project name"
    />
    <span
      class="studio-chip studio-chip-success "
    >
      Ready
    </span>
    <div
      class="studio-card studio-kpi "
    >
      <p
        class="text-sm text-text-muted"
      >
        Requests
      </p>
      <div
        class="studio-kpi-value"
      >
        120
      </div>
      Completed today
    </div>
  </div>,
  "mode": "dark",
  "theme": "neon-cyan",
  "variables": "--color-bg: #0c1217; --color-surface: #011f24; --color-surface-alt: #09282e; --color-border: #1f3d42; --color-text: #e7f0f2; --color-text-muted: #99b4b9; --color-primary: #47d8ef; --color-primary-fg: #0c1217; --color-primary-hover: #62e8fe; --color-accent: #69a7ff; --color-focus-ring: #47d8ef; --color-success: #71c575; --color-warning: #e1a035; --color-danger: #fa8880; --color-info: #68b3fe; --color-glow: #47d8ef; --color-surface-glass: #011f24; --color-border-glow: #47d8ef; --color-gradient-start: #0c1217; --color-gradient-end: #09282e; --color-chart-1: #47d8ef; --color-chart-2: #69a7ff; --color-chart-3: #626a70; --color-chart-4: #cbf4ff;",
}
`;

