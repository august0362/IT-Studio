// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shared glow primitives > snapshots semantic dark primitives for neon-cyan 1`] = `
{
  "markup": <div
    aria-label="Project overview"
    class="studio-card "
  >
    <button
      class="studio-button studio-button-primary "
      type="button"
    >
      Run
    </button>
    <button
      class="studio-button studio-button-secondary "
      type="button"
    >
      Cancel
    </button>
    <button
      class="studio-button studio-button-danger "
      type="button"
    >
      Delete
    </button>
    <input
      aria-label="Project name"
      class="studio-input "
      placeholder="Project name"
    />
    <span
      class="studio-chip studio-chip-success "
    >
      Ready
    </span>
    <div
      class="studio-card studio-kpi "
    >
      <p
        class="text-sm text-text-muted"
      >
        Requests
      </p>
      <div
        class="studio-kpi-value"
      >
        120
      </div>
      Completed today
    </div>
  </div>,
  "mode": "dark",
  "theme": "neon-cyan",
  "variables": "--ui-scale: 1; color-scheme: dark; --color-bg: #0e1517; --color-surface: #1a1f20; --color-surface-alt: #222b2c; --color-border: #767f81; --color-text: #e6f1f3; --color-text-muted: #a0aaac; --color-primary: #47d8ef; --color-primary-fg: #0e1517; --color-primary-hover: #47d8ef; --color-accent: #86bafe; --color-focus-ring: #47d8ef; --color-success: #49d3a1; --color-warning: #eba941; --color-danger: #ff958e; --color-info: #7cbdff; --color-glow: #47d8ef; --color-surface-glass: #1a1f20; --color-border-glow: #47d8ef; --color-gradient-start: #0e1517; --color-gradient-end: #222b2c; --color-chart-1: #47d8ef; --color-chart-2: #86bafe; --color-chart-3: #62d0a4; --color-chart-4: #e4ac59; --color-chart-5: #fb9890; --color-chart-6: #7cbdff;",
}
`;

