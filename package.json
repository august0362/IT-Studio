{
  "name": "it-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "dev": "npm run tauri:dev -w @itstudio/desktop",
    "lint": "eslint . --max-warnings 0 && prettier --check . --log-level warn && node scripts/scan-secrets.mjs",
    "lint:selftest": "node scripts/lint-fixtures/selftest.mjs",
    "pretest": "npm run lint:selftest",
    "test": "vitest run --project sidecar --project desktop --project vscode-ext",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node e2e/run-e2e.mjs",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p apps/sidecar/test/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "webdriverio": "9.32.0"
  }
}
