{
  "name": "it-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --cache .npm-cache run typecheck --workspaces --if-present && npm --cache .npm-cache run typecheck:tests",
    "build:sidecar": "node scripts/build/build-sidecar.mjs",
    "build:app": "node scripts/build/build-app.mjs",
    "release:bump": "node scripts/release/bump-version.mjs",
    "smoke:sidecar": "node scripts/build/smoke-sidecar.mjs",
    "dev": "npm run tauri:dev -w @itstudio/desktop",
    "lint": "eslint . --max-warnings 0 && prettier --check . --log-level warn && node -e \"const{execFileSync,spawnSync}=require('node:child_process');const{existsSync}=require('node:fs');const files=execFileSync('git',['ls-files','-z','-co','--exclude-standard'],{encoding:'utf8'}).split('\\0').filter((file)=>file&&!file.startsWith('scripts/lint-fixtures/')&&existsSync(file));const result=spawnSync(process.execPath,['scripts/scan-secrets.mjs',...files],{stdio:'inherit'});process.exitCode=result.status??1\"",
    "lint:selftest": "node scripts/lint-fixtures/selftest.mjs",
    "pretest": "npm run lint:selftest",
    "test": "vitest run --project sidecar --project desktop --project vscode-ext",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:vscode-e2e": "npm --cache .npm-cache run build -w itstudio-vscode && node apps/vscode-ext/test/e2e/run.mjs",
    "test:e2e": "node e2e/run-e2e.mjs",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p apps/sidecar/test/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "~10.0.0",
    "@stryker-mutator/vitest-runner": "~10.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "esbuild": "~0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "webdriverio": "9.32.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "monaco-editor": {
      "dompurify": "3.4.16"
    }
  }
}
